  m_Script: {fileID: 11500000, guid: aea1d911b5fe6994e8548cf326d790a8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueUI: {fileID: 373749545}
  dialogueLines:
  - "\uADF8\uB7FC \uD604\uC7AC \uC784\uAE08 1\uB2EC\uB7EC\uC5D0\uC11C 50\uC13C\uD2B8\uB97C
    \uC778\uC0C1\uD574 1\uB2EC\uB7EC 50\uC13C\uD2B8\uB97C \uC8FC\uACA0\uC18C."
  - "\uC0AC\uB538\uB77C."
  - "\uC624, \uBBF8\uC2A4\uD130 \uAE40. \uADF8\uAC74 \uBB34\uB9AC\uC694. \uBC30\uAC00
    \uB118\uB294 \uC778\uC0C1\uC774\uC624. 2\uB2EC\uB7EC\uBA74 \uC5B4\uB5BB\uACA0\uC18C?"
  - "4\uB538\uB77C."
  - "\uADF8\uAC74 \uC548 \uB418\uC624! 2\uB2EC\uB7EC 50\uC13C\uD2B8! \uADF8 \uC774\uC0C1\uC740
    \uC808\uB300 \uC548 \uB418\uC624!"
  - Four Dollars
  - "(\uB2F5\uB2F5\uD574\uD558\uBA70) \uBBF8\uC2A4\uD130 \uAE40, \uB9D0\uC774 \uC548
    \uD1B5\uD558\uB294\uAD70. \uD0C0\uD611\uC744 \uD574\uC57C \uD560 \uAC83 \uC544\uB2C8\uC624!
    3\uB2EC\uB7EC\uC694! \uCD5C\uC885 \uC81C\uC548\uC774\uC624."
  - 4$
  - "(\uACB0\uAD6D \uD3EC\uAE30\uD558\uBA70) \uC624\uCF00\uC774, \uC624\uCF00\uC774.
    \uC0AC\uB538\uB77C(4\uB2EC\uB7EC) \uC8FC\uACA0\uC18C."
  - "\uC624\uCF00\uC774, \uB561\uD050! \uC624\uCF00\uC774, \uC0AC\uB538\uB77C!"
  npcName: "\uBBF8\uAD70 \uC7A5\uC131"
  lineSpeakers: 00000000010000000000000001000000000000000100000000000000010000000000000001000000
  onDialogueCompleted:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1076829738}

  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 43313bb815d59934aa7d0005198d7b96, type: 3}
  m_Name: Page3Script
  m_EditorClassIdentifier: Assembly-CSharp::OfficialStoryScript
  lines:
  - id: P3_08_001
    section: 8
    speaker: "\uC8FC\uC778\uACF5(\uAC70\uCE5C \uC228)"
    speakerKind: 1
    text: "\uD558\uC544\u2026 \uD558\u2026"
  - id: P3_08_002
    section: 8
    speaker: "\uC8FC\uC778\uACF5(\uC791\uAC8C)"
    speakerKind: 1
    text: "\uB3C4\uB300\uCCB4 \uADF8 \uC7A5\uBA74\uB4E4\uC740 \uBB50\uC9C0..? \uC774\uD574\uD560\uC218\uC5C6\uC5B4."
  - id: P3_09_001
    section: 9
    speaker: "\uB538,\uC544\uB4E4"
    speakerKind: 0
    text: "\uC544\uBE60 \uAD1C\uCC2E\uC544\uC694? \uC800\uD76C \uB180\uB7EC\uAC00\uC694
      \uB300\uD68C \uB05D\uB098\uBA74 \uB2E4\uAC19\uC774 \uB9DB\uC788\uB294\uAC70
      \uBA39\uC73C\uB7EC \uAC00\uAE30\uB85C\uD588\uC796\uC544\uC694!"
  - id: P3_09_002
    section: 9
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\uB09C \uAD1C\uCC2E\uC544. \uB108\uD76C\uB07C\uB9AC \uB2E4\uB140\uC640."
  - id: P3_09_003
    section: 9
    speaker: "\uC640\uC774\uD504"
    speakerKind: 0
    text: "\uC6B0\uB9AC\uB07C\uB9AC \uAC00\uBA74 \uB204\uAC00 \uBA54\uB274 \uACE0\uB974\uB294\uB370?"
  - id: P3_09_004
    section: 9
    speaker: "\uC640\uC774\uD504"
    speakerKind: 0
    text: "\uADF8\uB0A0 \uC57D\uC18D\uD588\uC796\uC544. \uB05D\uB098\uBA74 \uB124\uAC00
      \uBA39\uACE0 \uC2F6\uC740 \uAC70 \uBA39\uC73C\uB7EC \uAC00\uAE30\uB85C."
  - id: P3_09_005
    section: 9
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\uADF8\uB798 \uADF8\uB807\uAC8C \uD558\uAE30\uB85C\uD588\uC9C0... \uBBF8\uC548\uD574
      \uC815\uC2E0\uC774 \uB108\uBB34 \uC5C6\uC5B4\uC11C.."
  - id: P3_09_006
    section: 9
    speaker: "\uC640\uC774\uD504"
    speakerKind: 0
    text: "\uAD1C\uCC2E\uC544. \uC11C\uB450\uB97C \uD544\uC694 \uC5C6\uC5B4. \uADF8\uB0E5
      \uB4DC\uB77C\uC774\uBE0C\uB9CC \uD574\uB3C4 \uB3FC."
  - id: P3_09_007
    section: 9
    speaker: "\uB538"
    speakerKind: 0
    text: "\uC544\uBE60 \uADF8\uB798\uC11C \uC800\uD76C \uBB50 \uBA39\uC73C\uB7EC\uAC00\uC694??"
  - id: P3_09_008
    section: 9
    speaker: "\uC8FC\uC778\uACF5(\uD76C\uBBF8\uD558\uAC8C \uC6C3\uC73C\uBA70)"
    speakerKind: 1
    text: "\uC544\uBE60\uB9D0\uACE0 \uC6B0\uB9AC \uB538\uC774 \uBA39\uACE0\uC2F6\uC740\uAC70
      \uBA39\uC73C\uB7EC \uAC00\uC790."
  - id: P3_09_009
    section: 9
    speaker: "\uB538"
    speakerKind: 0
    text: "\uADF8\uB7FC \uACE0\uAE30\uBA39\uC73C\uB7EC \uAC00\uC694 \uACE0\uAE30\uACE0\uAE30\uACE0\uAE30\uACE0\uAE30!!"
  - id: P3_09_010
    section: 9
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\uC88B\uB2E4. \uC6B0\uB9AC \uB2E4\uAC19\uC774 \uACE0\uAE30\uBA39\uC73C\uB7EC
      \uAC00\uC790."
  - id: P3_09_011
    section: 9
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\u2026\uC624\uB298 \uB098\uC624\uAE38 \uC798\uD55C \uAC83 \uAC19\uC544.
      \uACE0\uB9C8\uC6CC \uC5EC\uBCF4"
  - id: P3_10_001
    section: 10
    speaker: "\uC640\uC774\uD504"
    speakerKind: 0
    text: "\uC7A0\uAE50, \uC800 \uCC28\u2014!"
  - id: P3_10_002
    section: 10
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\uC548\uB3FC.................................................................................."
  - id: P3_10_003
    section: 10
    speaker: "\uC8FC\uC778\uACF5(\uBAA9\uC18C\uB9AC\uAC00 \uAC08\uB77C\uC9C0\uBA70)"
    speakerKind: 1
    text: "\uB300\uB2F5\uD574........."
  - id: P3_10_004
    section: 10
    speaker: "\uC8FC\uC778\uACF5(\uBAA9\uC18C\uB9AC\uAC00 \uAC08\uB77C\uC9C0\uBA70)"
    speakerKind: 1
    text: "\uC81C\uBC1C\u2026 \uB204\uAD6C\uB77C\uB3C4 \uB300\uB2F5\uD574\uC918.................................."

--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 43313bb815d59934aa7d0005198d7b96, type: 3}
  m_Name: Page4Script
  m_EditorClassIdentifier: Assembly-CSharp::OfficialStoryScript
  lines:
  - id: P4_11_001
    section: 11
    speaker: "\uAC04\uD638\uC0AC"
    speakerKind: 0
    text: "\uC758\uC2DD\uC774 \uB3CC\uC544\uC654\uC5B4\uC694. \uAC11\uC790\uAE30
      \uC6C0\uC9C1\uC774\uC9C0 \uB9C8\uC138\uC694."
  - id: P4_11_002
    section: 11
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\u2026\uAC00\uC871\uC740\uC694?"
  - id: P4_11_003
    section: 11
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\uC544\uB2C8\uC8E0?"
  - id: P4_11_004
    section: 11
    speaker: "\uC7A5\uAD50"
    speakerKind: 0
    text: "\uC6B0\uC120 \uB124 \uBAB8\uBD80\uD130\u2014"
  - id: P4_11_005
    section: 11
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\uAC00\uC871\uC774 \uC5B4\uB5BB\uAC8C \uB410\uB294\uC9C0\uB9CC \uB9D0\uD574."
  - id: P4_11_006
    section: 11
    speaker: "\uC7A5\uAD50(\uB0AE\uAC8C)"
    speakerKind: 0
    text: "\u2026\uBBF8\uC548\uD558\uB2E4."
  - id: P4_11_007
    section: 11
    speaker: "\uC8FC\uC778\uACF5(\uC18D\uC73C\uB85C)"
    speakerKind: 1
    text: "\uC774\uBC88\uC5D0\uB3C4\u2026 \uC544\uBB34\uB3C4 \uC7A1\uC9C0 \uBABB\uD588\uB2E4."
  - id: P4_12_001
    section: 12
    speaker: "\uC7A5\uAD50(\uB4A4\uC5D0\uC11C)"
    speakerKind: 0
    text: "\uC774\uC81C \uB9C9 \uD68C\uBCF5\uD588\uC796\uC544. \uC5B4\uB514 \uAC00\uB824\uACE0?"
  - id: P4_12_002
    section: 12
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\uC54C\uC544\uC57C\uACA0\uC5B4."
  - id: P4_12_003
    section: 12
    speaker: "\uC7A5\uAD50"
    speakerKind: 0
    text: "\uC9C0\uAE08 \uC138\uC0C1\uC740 \uB9DD\uD588\uC5B4. \uB098\uAC00\uC11C
      \uBB58 \uD558\uACA0\uB2E4\uACE0 \uB108\uAC00 \uC4F0\uB7EC\uC9C0\uACE0 \uC138\uC0C1\uC5D0\uB294
      \uD575\uC774 \uD130\uC9C0\uACE0 \uBC16\uC740 \uB0A8\uC544\uC788\uB294\uAC8C
      \uC5C6\uC5B4."
  - id: P4_12_004
    section: 12
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\uADF8\uB798\uB3C4 \uC6B0\uB9AC \uAC00\uC871\uC744 \uC8FD\uC774\uACE0
      \uB098\uB97C \uC704\uD5D8\uC5D0 \uBE60\uD2B8\uB9B0 \uC0C8\uB07C\uB294 \uC544\uC9C1
      \uC0B4\uC544\uC788\uC796\uC544."
  - id: P4_12_005
    section: 12
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\uADF8 \uC0C8\uB07C\uB97C \uC7A1\uC73C\uB7EC \uAC08\uAEBC\uC57C."
  - id: P4_12_006
    section: 12
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\uC7A1\uC544\uC11C \uBB3C\uC744\uAC70\uC57C. \uC65C \uADF8\uB7AC\uB294\uC9C0
      \uC65C \uB098\uC5EC\uC57C\uB9CC \uD588\uB294\uC9C0."
  - id: P4_12_007
    section: 12
    speaker: "\uC7A5\uAD50"
    speakerKind: 0
    text: "\u2026\uADF8\uB9AC\uACE0?"
  - id: P4_12_008
    section: 12
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\uADF8\uB9AC\uACE0. \uC8FD\uC774\uACA0\uC9C0."
  - id: P4_12_009
    section: 12
    speaker: "\uC7A5\uAD50"
    speakerKind: 0
    text: "\uADF8\uB798 \uC5EC\uAE30 \uB108\uAC00 \uC4F0\uB358 \uC7A5\uBE44\uB4E4\uC774\uC57C
      \uADF8\uB300\uB85C \uB0C5\uB480\uC5B4."
  - id: P4_12_010
    section: 12
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\uACE0\uB9C8\uC6CC \uCC59\uACA8\uC918\uC11C."
  - id: P4_13_001
    section: 13
    speaker: "\uC8FC\uC778\uACF5(\uC18D\uC73C\uB85C)"
    speakerKind: 1
    text: "\uADF8 \uB140\uC11D\uB4E4\uACFC \uC2F8\uC6B0\uB824\uBA74 \uB2E4\uC2DC
      \uAC10\uC744 \uCC3E\uC544\uC57C\uB9CC\uD574."
  - id: P4_14_001
    section: 14
    speaker: "\uC7A5\uAD50"
    speakerKind: 0
    text: "\uC544\uC9C1 \uCD1D\uC3D8\uB294 \uBC95\uC740 \uC78A\uC9C0\uC54A\uC558\uC9C0?
      \uC800\uC815\uB3C4\uC758 \uB354\uBBF8\uB4E4\uC740 \uAC00\uBCCD\uAC8C \uB9DE\uCDB0\uBCF4\uB77C\uACE0."
  - id: P4_14_002
    section: 14
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\uC800\uC815\uB3C4\uB294 \uAC00\uBCCD\uC9C0"
  - id: P4_14_003
    section: 14
    speaker: "\uC7A5\uAD50"
    speakerKind: 0
    text: "\uC544\uC9C1 \uC0B4\uC544\uC788\uAD6C\uB9CC \uD604\uC5ED\uC774\uC57C \uD604\uC5ED"
  - id: P4_14_004
    section: 14
    speaker: "\uC7A5\uAD50"
    speakerKind: 0
    text: "\uB108\uAC00 \uC798\uD558\uB358 \uB098\uC774\uD504\uB3C4 \uD718\uB458\uB7EC
      \uBD10."
  - id: P4_14_005
    section: 14
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\uC774 \uC815\uB3C4\uBA74 \uB410\uC5B4. \uC774\uC81C \uC2AC\uC2AC \uAC00\uC57C\uACA0\uC5B4
      \uC2DC\uAC04\uC744 \uB108\uBB34 \uC624\uB798 \uC37C\uC5B4."
  - id: P4_15_001
    section: 15
    speaker: "\uC640\uC774\uD504\uC640\uC758 \uAE30\uC5B5"
    speakerKind: 0
    text: "\uAD1C\uCC2E\uC544. \uC11C\uB450\uB97C \uD544\uC694 \uC5C6\uC5B4."
  - id: P4_15_002
    section: 15
    speaker: "\uC8FC\uC778\uACF5"
    speakerKind: 1
    text: "\uBBF8\uC548\uD574. \uAE08\uBC29 \uB4A4\uB530\uB77C \uAC08\uAC8C. \uC5EC\uBCF4."
